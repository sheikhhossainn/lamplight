# Copy to .env and fill in from your Supabase project settings (Project
# Settings -> API). The anon key is safe to ship in the app — it only ever
# grants what the `books` table's public-read RLS policy allows.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# GROQ_API_KEY / OPENAI_API_KEY belong in Supabase Edge Function secrets,
# never in this Expo client environment.
# Bangla Books API (Render/Turso backend)
EXPO_PUBLIC_BANGLA_API_URL=
EXPO_PUBLIC_BANGLA_TURSO_URL=
EXPO_PUBLIC_BANGLA_TURSO_TOKEN=

# RevenueCat public SDK keys. Use platform-specific keys in store builds.
# Set the Test Store key and flag only for RevenueCat development testing.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=false
