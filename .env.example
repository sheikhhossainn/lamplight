# Copy to .env and fill in from your Supabase project settings (Project
# Settings -> API). The anon key is safe to ship in the app — it only ever
# grants what the `books` table's public-read RLS policy allows.
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Bangla Books API (Render/Turso backend)
EXPO_PUBLIC_BANGLA_API_URL=
EXPO_PUBLIC_BANGLA_TURSO_URL=
EXPO_PUBLIC_BANGLA_TURSO_TOKEN=

